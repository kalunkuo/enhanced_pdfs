<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <RevitPath Condition="'$(RevitPath)' == ''">$(ProgramW6432)\Autodesk\Revit $(RevitVersion)</RevitPath>
    <!-- Revit 2025.0–2025.4 runs on .NET 8; later updates of the same install run on .NET 10. Build with -f to match the
         installed Revit (scripts/Install-RevitAddin.ps1 reads RevitAPI.runtimeconfig.json). The Windows 10 SDK target
         provides Windows.Data.Pdf for markup crops. -->
    <TargetFrameworks>net8.0-windows10.0.19041.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <Reference Include="RevitAPI" HintPath="$(RevitPath)/RevitAPI.dll" Private="false" />
    <Reference Include="RevitAPIUI" HintPath="$(RevitPath)/RevitAPIUI.dll" Private="false" />
    <PackageReference Include="Parquet.Net" Version="6.1.0" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MarkupReview.Core\MarkupReview.Core.csproj" />
    <!-- The stdio MCP bridge Claude Code launches; its exe lands next to the add-in. -->
    <ProjectReference Include="..\MarkupReview.Bridge\MarkupReview.Bridge.csproj" />
  </ItemGroup>
  <Target Name="CheckRevitReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(RevitPath)/RevitAPI.dll') Or !Exists('$(RevitPath)/RevitAPIUI.dll')"
           Text="Set RevitVersion to the installed Revit version (e.g. 2027), or set RevitPath directly to a directory containing its RevitAPI.dll and RevitAPIUI.dll." />
  </Target>
</Project>
