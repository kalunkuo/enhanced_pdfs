# Copy this file to .env.local, add your key there, then restart bun run dev.
# Never prefix a secret with VITE_; those variables are exposed to the browser.
# Choose bedrock or openai. Leave blank to select Bedrock when its token or model is set, otherwise OpenAI.
AGENT_PROVIDER=bedrock

# Bedrock API bearer token, not an AWS access-key ID/secret pair.
AWS_BEARER_TOKEN_BEDROCK=
# Use the Region where the token was generated and a model/inference profile available to that identity.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-opus-5-5

# Optional OpenAI alternative: set AGENT_PROVIDER=openai to use these values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
